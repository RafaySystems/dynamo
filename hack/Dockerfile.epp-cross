# Cross-compiling EPP build for linux/amd64 from an arm64 host WITHOUT QEMU
# emulating the Rust/Go compilers (which SIGILL under QEMU-TCG on Apple Silicon).
#
# Builder stages run natively on $BUILDPLATFORM (arm64) and cross-compile to
# x86_64; only the tiny runtime stage (apt/useradd) runs emulated, which QEMU
# handles fine for ordinary glibc binaries.
#
# Build from epp/ with the repo root as the "dynamo" context:
#   docker build -f hack/Dockerfile.epp-cross \
#     --platform linux/amd64 \
#     --build-context dynamo=<repo-root> \
#     -t registry.dev.rafay-edge.net/tf/dynamo-frontend:1.2.1-tool-fix \
#     deploy/inference-gateway/epp

ARG RUST_IMAGE=rust:1.93.1
ARG BUILDER_IMAGE=golang:1.25
ARG BASE_IMAGE=ubuntu:24.04

# =============================================================================
# Stage 1: Build Dynamo FFI static library (Rust) — native arm64, target amd64
# =============================================================================
FROM --platform=$BUILDPLATFORM ${RUST_IMAGE} AS rust-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    libclang-dev \
    gcc-x86-64-linux-gnu \
    g++-x86-64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add x86_64-unknown-linux-gnu

# Cross toolchain for target crates' cc/build scripts and the Rust linker.
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc \
    CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc \
    CXX_x86_64_unknown_linux_gnu=x86_64-linux-gnu-g++ \
    AR_x86_64_unknown_linux_gnu=x86_64-linux-gnu-ar

WORKDIR /dynamo

COPY --from=dynamo .cargo/ .cargo/
COPY --from=dynamo Cargo.toml Cargo.lock README.md ./
COPY --from=dynamo lib/ lib/

RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-cross,sharing=shared \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git-cross,sharing=shared \
    cargo build --release -p libdynamo_llm --target x86_64-unknown-linux-gnu && \
    mkdir -p /out && \
    cp target/x86_64-unknown-linux-gnu/release/libdynamo_llm_capi.a /out/ && \
    HEADER=$(find target/x86_64-unknown-linux-gnu/release/build -name llm_engine.h -path "*/out/*" | head -1) && \
    [ -n "$HEADER" ] && cp "$HEADER" /out/ || { echo "ERROR: llm_engine.h not found in target/"; exit 1; }

# =============================================================================
# Stage 2: Build Go EPP binary — native arm64, cross-compile CGO to amd64
# =============================================================================
FROM --platform=$BUILDPLATFORM ${BUILDER_IMAGE} AS go-builder

ARG COMMIT_SHA
ARG BUILD_REF

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-x86-64-linux-gnu \
    g++-x86-64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod,sharing=shared go mod download

COPY . .

COPY --from=rust-builder /out/libdynamo_llm_capi.a pkg/plugins/dynamo_kv_scorer/lib/
COPY --from=rust-builder /out/llm_engine.h pkg/plugins/dynamo_kv_scorer/include/

RUN --mount=type=cache,target=/go/pkg/mod,sharing=shared \
    --mount=type=cache,target=/root/.cache/go-build,sharing=shared \
    CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
    CC=x86_64-linux-gnu-gcc CXX=x86_64-linux-gnu-g++ \
    go build \
    -ldflags="-X sigs.k8s.io/gateway-api-inference-extension/version.GitVersion=${BUILD_REF} \
              -X sigs.k8s.io/gateway-api-inference-extension/version.GitCommit=${COMMIT_SHA}" \
    -o epp ./cmd/epp

# =============================================================================
# Stage 3: Runtime (linux/amd64)
# =============================================================================
FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /

COPY --from=go-builder /workspace/epp .

RUN useradd -r -u 65532 -g nogroup nonroot
USER 65532:65534

ENTRYPOINT ["/epp"]
